font-size = 18
macos-option-as-alt = true
keybind = clear
keybind = shift+enter=text:\x1b[13;2u
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
shell-integration-features = ssh-terminfo,ssh-env,sudo

theme = Monokai Remastered

# this is for cmd+1 to cmd+9 keybindings
keybind = cmd+1=text:\x1b[49;9u
keybind = cmd+2=text:\x1b[50;9u
keybind = cmd+3=text:\x1b[51;9u
keybind = cmd+4=text:\x1b[52;9u
keybind = cmd+5=text:\x1b[53;9u
keybind = cmd+6=text:\x1b[54;9u
keybind = cmd+7=text:\x1b[55;9u
keybind = cmd+8=text:\x1b[56;9u
keybind = cmd+9=text:\x1b[57;9u
