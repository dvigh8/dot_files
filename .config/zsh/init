# Starship prompt
if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi

#if command -v op &> /dev/null; then
#  eval "$(op signin)"
#  op_load_global
#fi

# Zoxide
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# Mise (runtime version manager)
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

# FZF
if command -v fzf &> /dev/null; then
  if [[ $(uname) == "Darwin" ]]; then
    [[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh
    [[ -f /opt/homebrew/opt/fzf/shell/completion.zsh ]] && source /opt/homebrew/opt/fzf/shell/completion.zsh
    [[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
  elif [[ $(uname) == "Linux" ]]; then
    [[ -f /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh
    [[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
  fi

  # Ensure fzf keybindings work with vi-mode
  bindkey '^R' fzf-history-widget
  bindkey '^T' fzf-file-widget
  bindkey '^E' fzf-cd-widget
fi

# Azure CLI completions
if command -v az &> /dev/null; then
  autoload bashcompinit && bashcompinit
  if [[ $(uname) == "Darwin" ]]; then
    [[ -f "$(brew --prefix)/etc/bash_completion.d/az" ]] && source "$(brew --prefix)/etc/bash_completion.d/az"
  elif [[ $(uname) == "Linux" ]]; then
    [[ -f /etc/bash_completion.d/azure-cli ]] && source /etc/bash_completion.d/azure-cli
  fi
fi

# Terraform completions
if command -v terraform &> /dev/null; then
  complete -o nospace -C terraform terraform
fi

# Source additional configs if they exist
[[ -f "$HOME/.envs" ]] && source "$HOME/.envs"
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
[[ -f "$HOME/.commands_manager" ]] && source "$HOME/.commands_manager"

# Name Herdr tabs from the active command, then from the prompt directory.
if [[ ${HERDR_ENV-} == 1 && -n ${HERDR_TAB_ID-} ]]; then
  autoload -Uz add-zsh-hook
  typeset -g _herdr_tab_last_label=''

  _herdr_tab_rename() {
    emulate -L zsh
    setopt extendedglob
    local label=$1
    label=${label//$'\n'/ }
    label=${label//$'\r'/ }
    label=${label//[^[:alnum:][:space:]_.:\/@+=-]/_}
    label=${label//[[:space:]]##/ }
    label=${label##[[:space:]]##}
    label=${label%%[[:space:]]##}
    label=${label[1,60]}
    [[ -n $label && $label != $_herdr_tab_last_label ]] || return

    _herdr_tab_last_label=$label
    herdr tab rename "$HERDR_TAB_ID" "$label" >/dev/null 2>&1 &!
  }

  _herdr_tab_preexec() {
    local -a words
    local word
    words=(${(z)1})
    for word in $words; do
      [[ $word == [[:alpha:]_][[:alnum:]_]*=* ]] && continue
      case $word in
        cd|pushd|popd|z|zi|zd) return ;;
      esac
      _herdr_tab_rename "$word"
      return
    done
  }

  _herdr_tab_precmd() {
    [[ $PWD != ${_herdr_tab_last_prompt_dir-} ]] || return
    _herdr_tab_last_prompt_dir=$PWD
    _herdr_tab_rename "${PWD:t}"
  }

  add-zsh-hook -d preexec _herdr_tab_preexec 2>/dev/null
  add-zsh-hook -d precmd _herdr_tab_precmd 2>/dev/null
  add-zsh-hook preexec _herdr_tab_preexec
  add-zsh-hook precmd _herdr_tab_precmd
fi
